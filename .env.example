# Names only. Never commit real values.
DATABASE_URL=postgres://fund:fund@localhost:5432/fund?sslmode=disable
TEST_DATABASE_URL=postgres://fund:fund@localhost:5432/fund_test?sslmode=disable
# Reuse the web app's BETTER_AUTH_SECRET value so existing signed tokens stay valid.
AUTH_SECRET=change-me-at-least-16-chars
PUBLIC_URL=http://localhost:4000
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
LOG_LEVEL=info
PORT=4000
# Where the client app lives (links in emails) and where this API lives (unsubscribe links).
API_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API (the Expo web app).
CORS_ORIGINS=http://localhost:8081
TRUST_PROXY=true
RATE_LIMIT=true
# Apply migrations at boot. Run `fund-migrate baseline` first on a database created by the web app.
MIGRATE_ON_START=false
